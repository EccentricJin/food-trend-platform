# Google Custom Search API
# 발급: https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# Custom Search Engine 생성: https://programmablesearchengine.google.com
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-custom-search-engine-id

# YouTube Data API v3
# 발급: https://console.cloud.google.com → API 및 서비스 → YouTube Data API v3 활성화
YOUTUBE_API_KEY=your-youtube-api-key

# Naver Search API (쇼핑 가격 수집용)
# 발급: https://developers.naver.com/apps → 검색 API 등록
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# News Domain API (뉴스 데이터 전송)
NEWS_API_BASE_URL=http://localhost:8080

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=food_trend_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=food_trend_db
MYSQL_POOL_SIZE=10
